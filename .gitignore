.DS_Store
__pycache__/
*.pyc
.env
.venv/
data/geo/

# Dossier de dépôt bioRxiv : seuls LISEZMOI et METADONNEES sont versionnés.
# La consigne Chrome contient les adresses de connexion (privée) ; PDF/DOCX/figures sont des copies locales.
manuscript_rmt/submission_bioRxiv/*
!manuscript_rmt/submission_bioRxiv/LISEZMOI.md
!manuscript_rmt/submission_bioRxiv/METADONNEES_bioRxiv.txt

# Dossier de dépôt Zenodo : seuls LISEZMOI et METADONNEES sont versionnés (la consigne contient les adresses de connexion).
manuscript_rmt/submission_Zenodo/*
!manuscript_rmt/submission_Zenodo/LISEZMOI.md
!manuscript_rmt/submission_Zenodo/METADONNEES_Zenodo.txt
